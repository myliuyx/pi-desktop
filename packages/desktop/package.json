{
  "name": "@agent/desktop",
  "productName": "Pi Workbench",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "description": "Pi Workbench —— 本地 core 服务 + 浏览器套壳的桌面封装",
  "homepage": "https://github.com/myliuyx/pi-workbench",
  "author": "myliuyx",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:boot-env": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/boot-env-check.mjs",
    "check:last-run": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/last-run-check.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "dist": "npm run build && electron-builder --publish never",
    "test:ci": "npm run typecheck && npm run check:boot-env && npm run check:last-run && npm run build"
  },
  "build": {
    "appId": "com.piworkbench.app",
    "productName": "Pi Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui-dist"
      },
      {
        "from": "../core/dist",
        "to": "core/dist"
      },
      {
        "from": "../core/package.json",
        "to": "core/package.json"
      },
      {
        "from": "../core/node_modules",
        "to": "core/node_modules"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "executableName": "pi-workbench",
      "maintainer": "myliuyx <myliuyx@users.noreply.github.com>"
    },
    "deb": {
      "packageName": "pi-workbench"
    },
    "artifactName": "Pi-Workbench-${version}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  }
}
