{
  "name": "@agent/ui",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:format": "node --experimental-strip-types scripts/format-check.mjs",
    "check:providers-source": "node --experimental-strip-types scripts/providers-source-check.mjs",
    "check:turns": "node --experimental-strip-types scripts/turns-check.mjs",
    "check:cn": "node --experimental-strip-types scripts/cn-check.mjs",
    "check:sidebar-layout": "node scripts/sidebar-layout-check.mjs",
    "check:adapter": "node --experimental-strip-types scripts/adapter-check.mjs",
    "check:contract": "node scripts/contract-mirror-check.mjs",
    "check:image-src": "node --experimental-strip-types scripts/image-src-check.mjs",
    "check:turn-rail": "node --experimental-strip-types scripts/turn-rail-check.mjs",
    "check:skill-search-state": "node --experimental-strip-types scripts/skill-search-state-check.mjs",
    "accept:m1": "node scripts/m1-acceptance.mjs",
    "accept:m2": "node scripts/m2-acceptance.mjs",
    "accept:m3": "node scripts/m3-acceptance.mjs",
    "accept:m4": "node scripts/m4-acceptance.mjs",
    "accept:m5": "node scripts/m5-acceptance.mjs",
    "live:smoke": "node scripts/live-smoke.mjs",
    "probe:c4": "node scripts/probe-c4-session-load.mjs",
    "probe:c5": "node scripts/probe-c5-live-screens.mjs",
    "probe:auth": "node scripts/probe-auth-input.mjs",
    "probe:settings": "node scripts/probe-settings-dialog.mjs",
    "probe:settings:live": "node scripts/probe-settings-live.mjs",
    "probe:settings:skills": "node scripts/probe-settings-skills.mjs",
    "probe:settings:plugins": "node scripts/probe-settings-plugins.mjs",
    "probe:onboarding": "node scripts/probe-settings-onboarding.mjs",
    "probe:dir-menu": "node scripts/probe-dir-menu.mjs",
    "probe:dir-menu:live": "node scripts/probe-dir-menu.mjs --live",
    "probe:new-session": "node scripts/probe-new-session.mjs",
    "probe:new-session:live": "node scripts/probe-new-session.mjs --live",
    "probe:process-collapse": "node scripts/probe-process-collapse.mjs",
    "probe:turn-rail": "node scripts/probe-turn-rail.mjs",
    "probe:spa-fallback": "node scripts/probe-spa-fallback.mjs",
    "probe:image-preview": "node scripts/probe-image-preview.mjs",
    "shots:m1": "node scripts/m1-shots.mjs",
    "test:ci": "npm run typecheck && npm run check:format && npm run check:providers-source && npm run check:turns && npm run check:cn && npm run check:sidebar-layout && npm run check:adapter && npm run check:contract && npm run check:image-src && npm run check:turn-rail && npm run build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
