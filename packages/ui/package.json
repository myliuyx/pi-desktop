{
  "name": "@agent/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:cn": "node --experimental-strip-types scripts/cn-check.mjs",
    "accept:m1": "node scripts/m1-acceptance.mjs",
    "accept:m2": "node scripts/m2-acceptance.mjs",
    "accept:m3": "node scripts/m3-acceptance.mjs",
    "accept:m4": "node scripts/m4-acceptance.mjs",
    "accept:m5": "node scripts/m5-acceptance.mjs",
    "shots:m1": "node scripts/m1-shots.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
