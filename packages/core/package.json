{
  "name": "@agent/core",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "security-check": "node scripts/core-security-check.mjs",
    "check:security-hardening": "node scripts/server-hardening-check.mjs",
    "check:trust": "node scripts/trust-policy-check.mjs",
    "smoke:check": "node scripts/core-smoke.mjs",
    "check:c3": "node scripts/c3-approval-check.mjs",
    "check:c4": "node scripts/c4-sessions-check.mjs",
    "check:sessions-new": "node scripts/sessions-new-check.mjs",
    "check:sessions-load": "node scripts/sessions-load-check.mjs",
    "check:run-dir": "node scripts/run-dir-check.mjs",
    "check:fs-list": "node scripts/fs-list-check.mjs",
    "check:fs-search": "node scripts/fs-search-check.mjs",
    "check:fs-image": "node scripts/fs-image-check.mjs",
    "check:prompt-filerefs": "node node_modules/tsx/dist/cli.mjs scripts/prompt-filerefs-check.mjs",
    "check:c5": "node scripts/c5-resources-models-check.mjs",
    "check:c6": "node scripts/c6-e2e-check.mjs",
    "check:providers": "node scripts/providers-check.mjs",
    "check:usage-branch": "node node_modules/tsx/dist/cli.mjs scripts/usage-branch-check.mjs",
    "check:tool-details": "node node_modules/tsx/dist/cli.mjs scripts/tool-details-check.mjs",
    "check:slash-commands": "node node_modules/tsx/dist/cli.mjs scripts/slash-commands-check.mjs",
    "smoke": "node node_modules/tsx/dist/cli.mjs src/main.ts",
    "check:session-title": "node node_modules/tsx/dist/cli.mjs scripts/session-title-check.mjs",
    "check:session-cache-scan": "node node_modules/tsx/dist/cli.mjs scripts/session-cache-scan-check.mjs",
    "check:session-cache-index": "node node_modules/tsx/dist/cli.mjs scripts/session-cache-index-check.mjs",
    "check:session-subagent": "node node_modules/tsx/dist/cli.mjs scripts/session-subagent-check.mjs",
    "check:session-list-perf": "node node_modules/tsx/dist/cli.mjs scripts/session-list-perf-check.mjs",
    "check:error-visible": "node node_modules/tsx/dist/cli.mjs scripts/error-visible-check.mjs",
    "check:sessions-manage": "node scripts/sessions-manage-check.mjs",
    "check:skills-install": "node node_modules/tsx/dist/cli.mjs scripts/skills-install-check.mjs",
    "check:compat": "node node_modules/tsx/dist/cli.mjs scripts/compat-object-check.mjs",
    "check:model-select": "node node_modules/tsx/dist/cli.mjs scripts/model-select-persist-check.mjs",
    "check:file-perms": "node node_modules/tsx/dist/cli.mjs scripts/file-perms-check.mjs",
    "check:thinking-levels": "node scripts/thinking-levels-align-check.mjs",
    "check:model-info": "node node_modules/tsx/dist/cli.mjs scripts/model-info-check.mjs",
    "test:ci": "npm run typecheck && npm run build && npm run check:thinking-levels && npm run check:model-info && npm run security-check && npm run check:security-hardening && npm run check:trust && npm run check:run-dir && npm run check:fs-list && npm run check:fs-search && npm run check:fs-image && npm run check:prompt-filerefs && npm run check:error-visible && npm run check:usage-branch && npm run check:tool-details && npm run check:slash-commands && npm run check:session-title && npm run check:sessions-manage && npm run check:skills-install && npm run check:compat && npm run check:model-select && npm run check:file-perms && npm run check:session-cache-scan && npm run check:session-cache-index && npm run check:session-subagent && npm run check:session-list-perf"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
