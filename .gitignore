# 依赖
node_modules/

# 构建产物与类型缓存
dist/
*.tsbuildinfo

# 本机临时输出（跑脚本时产生的 _chk*.txt 等）
_chk*.txt
_pi-*.log

# 脚本落盘产物（验证/探针跑出来的临时日志与截图；据可通过重跑复现，不入库）
run-*.txt
COMMIT_MSG.txt
push-result.txt
packages/ui/run/
packages/ui/_*.png
# 各探针自起 core 的 stderr 日志（probe:settings:live / probe:onboarding …）
packages/ui/_*-core.log

# 截图缓存（可随时重新生成，不入库）
.workbuddy/
.plan/

# SDD 子代理执行的临时工作区（ledger / briefs / reports / review packages，gitignored scratch）
.superpowers/

# vendored 上游仓库：pi 是 earendil-works/pi 的本地 clone（未做本地改动、无自带 .git），
# 不入库以免污染本仓库历史；需要时用 `git clone https://github.com/earendil-works/pi pi` 还原。
# 若将来要对 pi 做本地修改，删掉下面这行改为入库。
pi/
